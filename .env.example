# Backend Environment Variables — غير مربوط افتراضياً
# cp .env.example .env ثم املأ القيم بعد إنشاء حساباتك الجديدة

OTPIQ_API_KEY=
OTPIQ_BASE_URL=https://api.otpiq.com
OTPIQ_WHATSAPP_PROVIDER=whatsapp
OTP_DEFAULT_CHANNEL=whatsapp
OTP_WHATSAPP_ONLY=true
OTPIQ_SMS_PROVIDER=sms
OTP_TTL_MS=300000
OTP_LENGTH=6
SESSION_SECRET=
PORT=3000
CORS_ALLOWED_ORIGINS=
RATE_LIMIT_GENERAL_MAX=120
RATE_LIMIT_OTP_SEND_MAX=5
RATE_LIMIT_OTP_VERIFY_MAX=10
ADMIN_PHONES=
ADMIN_LOGIN_BYPASS_SECRET=
ADMIN_LOGIN_BYPASS_PHONES=
ENABLE_EMERGENCY_ROUTES=false
EMERGENCY_API_KEY=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# كلمة مرور Postgres (Settings → Database) — لتشغيل npm run apply-supabase-bootstrap
SUPABASE_DB_PASSWORD=
# أو انسخ Session pooler URI كاملاً من Dashboard:
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

MAPBOX_ACCESS_TOKEN=
MAPBOX_PUBLIC_TOKEN=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
CLOUDFLARE_API_TOKEN=

FIREBASE_SERVICE_ACCOUNT_JSON=

SOCKET_BROADCAST_URL=
SOCKET_BROADCAST_KEY=

VOICE_PROVIDER=livekit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

REDIS_URL=
ENABLE_SERVER_WARMUP=true
